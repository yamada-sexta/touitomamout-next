
# USERNAME and PASSWORD are not required but are recommended for a more stable session.
# These two variables are used for the scraper login process.
TWITTER_USERNAME=your_x_username
TWITTER_PASSWORD=YourXPassword

# Optional: cookies copied from the Cookie request header of a logged-in X.com
# browser session. Recommended when X blocks username/password login (error 399).
# Keep this secret. It must include the auth_token and ct0 cookies.
# TWITTER_COOKIES="auth_token=...; ct0=..."

# Target Twitter/X handle
TWITTER_HANDLE=YourXHandle

# Mirror the X pinned post and its pin status on Bluesky, Mastodon and Misskey.
# Enabled by default; set to false to opt out.
SYNC_PINNED_POSTS=true

# Optional text appended to every mirrored post, separated by a blank line.
# Quote values containing hashtags so they are not parsed as comments.
POST_APPEND="#example #hashtags"

#--- ☁️ Bluesky Credentials (Optional) ---#
# If not set, BLUESKY_INSTANCE defaults to "bsky.social".
BLUESKY_INSTANCE=bsky.social
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=xxxx-xxxx-xxxx-xxxx # Use an app password, not your main password

#--- 🦣 Mastodon Credentials (Optional) ---#
# If not set, MASTODON_INSTANCE defaults to "mastodon.social".
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=YourMastodonAccessToken

#--- Ⓜ️ Misskey Credentials (Optional) ---#
MISSKEY_INSTANCE=https://your-instance.net # e.g., misskey.io
MISSKEY_ACCESS_CODE=YourMisskeyApiToken # Generate this in Settings > API

#--- 🇩 Discord Webhook (Optional) ---#
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcde-fghij

#--- 🅣 Tumblr Credentials (Optional) ---#
TUMBLR_CONSUMER_KEY=YourTumblrConsumerKey
TUMBLR_CONSUMER_SECRET=YourTumblrConsumerSecret
TUMBLR_TOKEN=YourTumblrOAuthToken
TUMBLR_TOKEN_SECRET=YourTumblrOAuthTokenSecret
