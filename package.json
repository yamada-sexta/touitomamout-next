{
  "name": "touitomamout-next",
  "version": "2.0.0",
  "description": "An easy way to synchronize your posts from X.com to other social media.",
  "scripts": {
    "format": "prettier --write .",
    "build": "mkdir -p dist && scriptc build ./src/index.ts --dynamic -o dist/touitomamout",
    "build:all": "npm run build",
    "build:linux-x64": "npm run build",
    "build:linux-x64-musl": "npm run build",
    "build:linux-arm64-musl": "npm run build",
    "build:windows-x64": "npm run build",
    "build:macos-x64": "npm run build",
    "build:macos-arm64": "npm run build",
    "dev": "bun run src/index.ts",
    "check": "bun tsc --noEmit",
    "gen:migration": "bun run src/db/generate.ts"
  },
  "type": "module",
  "author": "Yamada Sexta",
  "homepage": "https://github.com/yamada-sexta/touitomamout-next",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yamada-sexta/touitomamout-next.git"
  },
  "dependencies": {
    "@atproto/api": "^0.20.42",
    "@atproto/lex": "^0.3.8",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "cli-spinners": "^3.4.0",
    "cron": "^4.4.0",
    "cycletls": "^2.0.5",
    "drizzle-orm": "^0.45.2",
    "html-entities": "^2.6.0",
    "masto": "^8.0.0",
    "misskey-js": "^2026.8.0-alpha.0",
    "ora": "^9.4.1",
    "tough-cookie": "^6.0.2",
    "tumblr.js": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "discord-api-types": "^0.38.54",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "0.31.10",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "scriptc": "^0.0.34"
  },
  "module": "src/index.ts",
  "private": true
}
