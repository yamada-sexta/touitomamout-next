{
  "name": "touitomamout-next",
  "version": "2.0.0",
  "description": "An easy way to synchronize your posts from X.com to other social media.",
  "scripts": {
    "format": "prettier --write .",
    "build": "scriptc compile ./src/index.ts --output dist/touitomamout",
    "dev": "node --import tsx/esm src/index.ts",
    "test": "node --test --import tsx/esm src/**/*.test.ts",
    "check": "tsc --noEmit",
    "gen:migration": "node --import tsx/esm src/db/generate.ts"
  },
  "type": "module",
  "author": "Yamada Sexta",
  "homepage": "https://github.com/yamada-sexta/touitomamout-next",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yamada-sexta/touitomamout-next.git"
  },
  "dependencies": {
    "@atproto/api": "^0.20.36",
    "@atproto/lex": "^0.3.2",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "better-sqlite3": "^11.0.0",
    "cli-spinners": "^3.4.0",
    "cron": "^4.4.0",
    "cycletls": "^2.0.5",
    "drizzle-orm": "^0.45.2",
    "html-entities": "^2.6.0",
    "masto": "^8.0.0",
    "misskey-js": "^2026.7.0",
    "ora": "^9.4.1",
    "tough-cookie": "^6.0.2",
    "tumblr.js": "^5.0.1",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "discord-api-types": "^0.38.52",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "drizzle-kit": "0.31.10",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "module": "src/index.ts",
  "private": true
}
